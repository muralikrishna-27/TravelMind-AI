# TravelMind AI — Frontend Environment Variables
# Copy to .env.local for local development, or configure in Vercel Project Settings -> Environment Variables for production.

# Base URL of the FastAPI + LangGraph backend (no trailing slash).
# Local development default: http://127.0.0.1:8000
# Production example: https://travelmind-backend.onrender.com
BACKEND_URL=http://127.0.0.1:8000
